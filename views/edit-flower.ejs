<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Flower</title>
</head>

<body>

    <%- include('./partials/navbar') %>

        <h1>Edit Flower</h1>

        <form action="/flowers/<%= flower._id %>?_method=PUT" method="POST">

            <label for="name">Flower Name:</label>
            <input type="text" id="name" name="name" value="<%= flower.name %>" required>

            <label for="price">Price:</label>
            <input type="number" id="price" name="price" min="0" step="0.01" value="<%= flower.price ?? '' %>">

            <label for="inStock">In Stock:</label>
            <input type="checkbox" id="inStock" name="inStock" <%=flower.inStock===true ? 'checked' : '' %>>

            <label for="bestBefore">Best Before:</label>
            <input type="date" id="bestBefore" name="bestBefore"
                value="<%= flower.bestBefore ? flower.bestBefore.toISOString().slice(0, 10) : '' %>">

            <button type="submit">Update Flower</button>

        </form>

</body>

</html>